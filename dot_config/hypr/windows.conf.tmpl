##############################
### WINDOWS AND WORKSPACES ###
##############################

# Ignore maximize requests from apps. You'll probably like this.
windowrule = match:class .*, suppress_event maximize

# Fix some dragging issues with XWayland
windowrule = match:class ^$ match:title ^$ match:xwayland 1 match:floating 1 match:fullscreen 0 match:pinned 0, no_focus 1

{{ if eq .chezmoi.hostname "galileo" }}
workspace = 1, monitor:DP-1, persistent:true, default:true
workspace = 2, monitor:DP-1, persistent:true
workspace = 3, monitor:DP-1, persistent:true
workspace = 4, monitor:DP-1, persistent:true
workspace = 5, monitor:DP-1, persistent:true

# For second monitor
# workspace = 6, monitor:DP-2, persistent:true
# workspace = 7, monitor:DP-2, persistent:true
# workspace = 8, monitor:DP-2, persistent:true
# workspace = 9, monitor:DP-2, persistent:true
# workspace = 10, monitor:DP-2, persistent:true
{{ else if eq .chezmoi.hostname "zephyrus" }}
workspace = 1, monitor:eDP-1, persistent:true, default:true
workspace = 2, monitor:eDP-1, persistent:true
workspace = 3, monitor:eDP-1, persistent:true
workspace = 4, monitor:eDP-1, persistent:true
workspace = 5, monitor:eDP-1, persistent:true
{{ end }}

# clipse
windowrule = match:class clipse, float 1 # ensure you have a floating window class set if you want this behavior
windowrule = match:class clipse, size 622 652 # set the size of the window as necessary

# Make Dolphin file picker (e.g., "Save File" dialog) float
windowrule = match:class org.freedesktop.impl.portal.desktop.kde, float 1
{{ if eq .chezmoi.hostname "galileo" }}
windowrule = match:class org.freedesktop.impl.portal.desktop.kde, size (monitor_w*0.45) (monitor_h*0.45)
{{ else if eq .chezmoi.hostname "zephyrus" }}
windowrule = match:class org.freedesktop.impl.portal.desktop.kde, size (monitor_w*0.70) (monitor_h*0.65)
{{ end }}
windowrule = match:class org.freedesktop.impl.portal.desktop.kde, center 1

# floating kitty
windowrule = match:class ^(kitty-floating)$, float 1
windowrule = match:class ^(kitty-floating)$, center 1
{{- if eq .chezmoi.hostname "galileo" }}
windowrule = match:class ^(kitty-floating)$, size (monitor_w*0.50) (monitor_h*0.50)
{{- else if eq .chezmoi.hostname "zephyrus" }}
windowrule = match:class ^(kitty-floating)$, size (monitor_w*0.70) (monitor_h*0.65)
{{- end }}

# raycast-style notes popup (Super+W)
windowrule = match:class ^(notes)$, float 1
windowrule = match:class ^(notes)$, center 1
windowrule = match:class ^(notes)$, size (monitor_w*0.5) (monitor_h*0.6)

# Make sure it doesn't get caught by other window rules
# windowrule = match:class ^(kitty)$ match:title ^(?!Floating Terminal).*$, tile true
layerrule {
    name = vicinae-blur
    blur = on
    ignore_alpha = 0
    match:namespace = vicinae
}

layerrule {
    name = vicinae-no-animation
    no_anim = on
    match:namespace = vicinae
}

# === swaync liquid glass ===
# blur whatever is behind the panel (wallpaper AND other windows). xray was
# turned off so the effect is visible even when an opaque app fills the screen.
# Hyprland 0.55+ requires the explicit `on` value and `match:namespace` selector.
layerrule = blur on, match:namespace swaync-control-center
layerrule = ignore_alpha 0.5, match:namespace swaync-control-center
layerrule = blur on, match:namespace swaync-notification-window
layerrule = ignore_alpha 0.5, match:namespace swaync-notification-window

# === browser extension popups (Bitwarden, 1Password, etc.) ===
# Brave/Chrome extensions that pop out as separate windows have an
# initialTitle of `_crx_<extension-id>`. Match on that to catch them all.
windowrule = match:initial_title ^_crx_.*$, float 1
windowrule = match:initial_title ^_crx_.*$, center 1
windowrule = match:initial_title ^_crx_nngceckbapebfimnlniiiahkandclblb$, size 500 700

# === picture-in-picture (YouTube, Twitch, etc.) ===
windowrule = match:title ^(Picture-in-Picture)$, float 1
windowrule = match:title ^(Picture-in-Picture)$, pin 1
windowrule = match:title ^(Picture-in-Picture)$, size 480 270
windowrule = match:title ^(Picture-in-Picture)$, move 100%-w-20 100%-h-20

# === authentication / password dialogs ===
windowrule = match:class ^(polkit-kde-authentication-agent-1)$, float 1
windowrule = match:class ^(polkit-kde-authentication-agent-1)$, center 1
windowrule = match:class ^(org\.kde\.kwalletmanager5|org\.keepassxc\.KeePassXC)$, float 1
windowrule = match:class ^(ssh-askpass)$, float 1

# === system applets ===
windowrule = match:class ^(pavucontrol|\.blueman-manager-wrapped|nm-connection-editor|blueberry\.py)$, float 1
windowrule = match:class ^(pavucontrol)$, size 600 700
windowrule = match:class ^(pavucontrol|\.blueman-manager-wrapped|nm-connection-editor)$, center 1

# === screenshot annotator ===
windowrule = match:class ^(swappy)$, float 1
windowrule = match:class ^(swappy)$, center 1

# === media viewers + calculators ===
windowrule = match:class ^(mpv|imv|org\.gnome\.Loupe|qalculate-gtk)$, float 1

# === universal file pickers (any app) ===
# ~0.45x0.45 of the monitor (derived from a live 1150x644 dialog on 2560x1440)
# so they stop spawning near-fullscreen; centered for consistency.
windowrule = match:title ^(Open File|Save File|Save As|File Upload|Select Folder|Choose Files)$, float 1
windowrule = match:title ^(Open File|Save File|Save As|File Upload|Select Folder|Choose Files)$, size (monitor_w*0.45) (monitor_h*0.45)
windowrule = match:title ^(Open File|Save File|Save As|File Upload|Select Folder|Choose Files)$, center 1

# === Chromium/Brave native file dialogs ===
# These open as a browser-class window titled "<origin> wants to save/open"
# (the in-browser upload/download picker) and otherwise spawn near-fullscreen.
windowrule = match:title ^(.* wants to (save|open).*)$, float 1
windowrule = match:title ^(.* wants to (save|open).*)$, size (monitor_w*0.45) (monitor_h*0.45)
windowrule = match:title ^(.* wants to (save|open).*)$, center 1

exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
