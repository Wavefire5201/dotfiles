hl.config({
    input = {
        kb_layout  = "us",
        kb_variant = "",
        kb_model   = "",
        kb_options = "",
        kb_rules   = "",

        follow_mouse = 1,
{{- if eq .chezmoi.hostname "galileo" }}
        sensitivity = -0.8, -- -1.0 - 1.0, 0 means no modification
{{- else if eq .chezmoi.hostname "zephyrus" }}
        sensitivity = 0,
{{- end }}

        touchpad = {
            natural_scroll = true,
            scroll_factor  = 0.3,
        },
    },
})

hl.gesture({ fingers = 3, direction = "horizontal", action = "workspace" })

hl.device({ name = "glorious-model-d-2-pro---4k/8khz-edition-1", sensitivity = -0.8 })
