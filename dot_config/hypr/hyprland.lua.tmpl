-----------------
--- AUTOSTART ---
-----------------

-- Hyprland ignores ~/.config/autostart, so apps' own "start at login" toggles do nothing
-- Hyprland 0.57 imports env into systemd before hl.env runs, so systemd-started portals miss
-- QT_QPA_PLATFORMTHEME and the KDE file dialog loses the Plasma theme. Push the theme vars too.
local dbusEnv = "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP QT_QPA_PLATFORMTHEME QT_QPA_PLATFORM XCURSOR_THEME XCURSOR_SIZE"

hl.on("hyprland.start", function()
    hl.exec_cmd("/usr/lib/pam_kwallet_init")
    hl.exec_cmd("/usr/bin/kwalletd6")
    hl.exec_cmd("/usr/lib/polkit-kde-authentication-agent-1")
    hl.exec_cmd("hypridle & playerctld daemon")
    hl.exec_cmd("fcitx5 -d")
    hl.exec_cmd("clipse -listen")
    hl.exec_cmd("udiskie")
    hl.exec_cmd("qs -c noctalia-shell")
    hl.exec_cmd("kbuildsycoca6")
    hl.exec_cmd("/opt/blip/bin/blip --background --delay 5")
    hl.exec_cmd("handy")
    -- paseo.service starts at boot (linger on); this only starts it if it was stopped.
    -- Not restart: that kills agent turns in progress, so its agents lack WAYLAND_DISPLAY until a manual restart
    hl.exec_cmd(dbusEnv .. " && systemctl --user start paseo.service")
    -- Portals outlive Hyprland; one started between sessions has no XDG_CURRENT_DESKTOP, falls back to gtk, and loses ScreenCast
    hl.exec_cmd(dbusEnv .. " && systemctl --user try-restart xdg-desktop-portal.service xdg-desktop-portal-hyprland.service xdg-desktop-portal-gtk.service plasma-xdg-desktop-portal-kde.service")
end)

-----------------------------
--- ENVIRONMENT VARIABLES ---
-----------------------------

hl.env("XCURSOR_THEME", "macOS")
hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_THEME", "macOS-hyprcursor")
hl.env("HYPRCURSOR_SIZE", "24")
hl.env("QT_QPA_PLATFORM", "wayland;xcb")
hl.env("QT_QPA_PLATFORMTHEME", "kde")
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "wayland")
hl.env("XDG_MENU_PREFIX", "arch-")
hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_TYPE", "wayland")
hl.env("SSH_AUTH_SOCK", os.getenv("XDG_RUNTIME_DIR") .. "/ssh-agent.socket")
-- fcitx5: leave GTK_IM_MODULE and SDL_IM_MODULE unset on Wayland so apps use
-- the native Wayland input-method frontend (see fcitx-im.org/wiki/Using_Fcitx_5_on_Wayland)
hl.env("QT_IM_MODULE", "fcitx")
hl.env("XMODIFIERS", "@im=fcitx")

