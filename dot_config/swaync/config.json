{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "cssPriority": "user",
  "control-center-width": 450,
  "control-center-height": 1000,
  "control-center-margin-top": 2,
  "control-center-margin-bottom": 1,
  "control-center-margin-right": 1,
  "control-center-margin-left": 0,
  "notification-window-width": 400,
  "notification-icon-size": 48,
  "notification-body-image-height": 160,
  "notification-body-image-width": 200,
  "timeout": 4,
  "timeout-low": 2,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "notification-grouping": false,
  "transition-time": 100,
  "hide-on-clear": false,
  "hide-on-action": false,
  "script-fail-notify": true,
  "scripts": {},
  "notification-visibility": {
    "spotify": {
      "state": "enabled",
      "urgency": "Low",
      "app-name": "Spotify"
    }
  },
  "widgets": [
    "label",
    "buttons-grid",
    "volume",
    "mpris",
    "dnd",
    "title",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": " 󰎟 "
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "label": {
      "max-lines": 1,
      "text": "Notification Center"
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 12,
      "blacklist": ["playerctld"]
    },
    "volume": {
      "label": "󰕾 ",
      "show-per-app": false
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰖁",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "type": "toggle"
        },
        {
          "label": "󰍭",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "type": "toggle"
        },
        {
          "label": "󰤨",
          "command": "nm-connection-editor"
        },
        {
          "label": "󰂯",
          "command": "blueman-manager"
        },
        {
          "label": "󰌾",
          "command": "hyprlock"
        },
        {
          "label": "󰜉",
          "command": "~/.config/hypr/scripts/confirm.sh 'Reboot the system now?' 'systemctl reboot'"
        },
        {
          "label": "󰐥",
          "command": "~/.config/hypr/scripts/confirm.sh 'Shut down the system now?' 'systemctl poweroff'"
        }
      ]
    }
  }
}
