{
  "id": "ai-usage-lite",
  "name": "AI Usage Lite",
  "version": "0.1.0",
  "minNoctaliaVersion": "3.6.0",
  "author": "wavefire",
  "license": "MIT",
  "description": "Compact Claude, Codex (multi-workspace), and OpenCode Go usage widget.",
  "tags": [
    "Bar",
    "Productivity",
    "AI"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "refreshIntervalSec": 120,
      "order": "claude,codex,codex2,antigravity,opencode",
      "separator": "  ",
      "showTooltips": true,
      "showOnlyWorst": false,
      "claudeEnabled": true,
      "codexEnabled": true,
      "antigravityEnabled": true,
      "opencodeEnabled": true,
      "claudeFormat": "Cl {session_pct}%",
      "codexFormat": "Cx {session_pct}%",
      "antigravityFormat": "AG {worst_pct}%",
      "opencodeFormat": "Go {max_pct}%",
      "tooltipFormat": "compact",
      "codex2Enabled": false,
      "codex2Format": "Cx2 {session_pct}%",
      "codex2Profile": "alt",
      "codexLabel": "",
      "codex2Label": ""
    }
  }
}
