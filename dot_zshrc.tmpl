# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time oh-my-zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(git gh docker zsh-syntax-highlighting zsh-autosuggestions zsh-history-substring-search you-should-use)
fpath+="${ZSH_CUSTOM:-"$ZSH/custom"}/plugins/zsh-completions/src"
source $ZSH/oh-my-zsh.sh

# zsh-history-substring-search options
bindkey "$terminfo[kcuu1]" history-substring-search-up
bindkey "$terminfo[kcud1]" history-substring-search-down

# Set personal aliases, overriding those provided by oh-my-zsh libs,
# plugins, and themes. Aliases can be placed here, though oh-my-zsh
# users are encouraged to define aliases within the ZSH_CUSTOM folder.
# For a full list of active aliases, run `alias`.

# environment variables
export EDITOR="nvim"
export XDG_CONFIG_HOME="$HOME/.config"
export ANDROID_HOME="$HOME/Android/Sdk/"

# path
export PATH=$PATH:$HOME/.spicetify
# adds ~/.local/bin and subfolders to $PATH
export PATH="$PATH:${$(find ~/.local/bin -maxdepth 1 -type d -printf %p:)%%:}"
export PATH="$HOME/.npm-global/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

# aliases
alias cat='bat'
alias ff='fastfetch'
alias ls="eza -lh --group-directories-first --icons=auto"
alias cd="z"
alias dupdate="docker compose pull && docker compose up -d"
alias sp="spotify_player"
alias zj="zellij"

# zj session completion: `zj a <TAB>` completes session names
# Registered for zellij too: with complete_aliases off, zsh expands the
# `zj` alias to `zellij` before completing, so a zj-only compdef never runs.
_zj_complete() {
  if [[ ${words[CURRENT-1]} == (a|attach) ]]; then
    local -a sessions
    sessions=(${(f)"$(zellij list-sessions --short 2>/dev/null)"})
    (( $#sessions )) && compadd -a sessions
  else
    (( $+functions[_zellij] )) || autoload -Uz _zellij
    _zellij "$@"
  fi
}
compdef _zj_complete zj zellij
alias ud="fd -e zip -x bash -c 'mkdir -p "{.}" && unzip -n -q "{}" -d "{.}"'"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
# bun completions
[ -s "/home/wavefire/.bun/_bun" ] && source "/home/wavefire/.bun/_bun"

# deno
source "/home/wavefire/.deno/env"

# uv
eval "$(uv generate-shell-completion zsh)" # you should already have these two lines
eval "$(uvx --generate-shell-completion zsh)"

# you will need to add the lines below
# https://github.com/astral-sh/uv/issues/8432#issuecomment-2453494736
_uv_run_mod() {
    if [[ "$words[2]" == "run" && "$words[CURRENT]" != -* ]]; then
        _arguments '*:filename:_files'
    else
        _uv "$@"
    fi
}
compdef _uv_run_mod uv

# zoxide
eval "$(zoxide init zsh)"
# Claude Code's Bash tool resets shell CWD between commands, which trips
# zoxide's doctor as a false positive. No-op it inside Claude Code.
if [[ -n "$CLAUDECODE" ]]; then
    __zoxide_doctor() { return 0; }
fi

# ssh-agent: point shells at the systemd user ssh-agent.service socket so a key
# loaded once (or auto-added via AddKeysToAgent) is shared across all terminals.
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

# Supabase access token: loaded from the canonical secret file (mode 600) so
# Claude Code and Codex can pick it up via $SUPABASE_ACCESS_TOKEN.
export SUPABASE_ACCESS_TOKEN="$(cat ~/.config/supabase/access-token 2>/dev/null)"
